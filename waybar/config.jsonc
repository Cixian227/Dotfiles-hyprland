{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "group/player"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "disk#1", "disk#2","pulseaudio", "hyprland/language", "tray"],

   // --- ГРУППА ПЛЕЕРА ---
    "group/player": {
        "orientation": "horizontal",
        "modules": [
            "custom/player-prev",
            "custom/player-play",
            "custom/player-next",
            "custom/playerctl"
        ]
    },

  "custom/playerctl": {
        "format": "{}", // Убрали значок отсюда
        "return-type": "json",
        "max-length": 35,
        // Теперь иконка 󰎈 выводится только тогда, когда есть метаданные
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then playerctl metadata --format '{\"text\": \"󰎈 {{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}'; else echo '{\"text\": \"\", \"class\": \"hidden\"}'; fi; sleep 1; done",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/player-prev": {
        "format": "󰒮 ",
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then echo \"󰒮\"; else echo \"\"; fi; sleep 1; done",
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/player-play": {
        "format": "{icon}",
        "return-type": "json",
        "format-icons": {
            "Playing": "󰏤 ",
            "Paused": "󰐊 "
        },
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then playerctl metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}'; else echo '{\"alt\": \"\", \"class\": \"hidden\"}'; fi; sleep 1; done",
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/player-next": {
        "format": "󰒭",
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then echo \"󰒭\"; else echo \"\"; fi; sleep 1; done",
        "on-click": "playerctl next",
        "tooltip": false
    }, 
    
    // --- ОСТАЛЬНЫЕ МОДУЛИ (БЕЗ ИЗМЕНЕНИЙ) ---
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": " ",
            "2": " ",
            "3": "󰎆 ",
            "4": "󰓓 ",
            "5": "󰏆",
            "6": "󰙯 ",
            "default": " "
        },
        "persistent-workspaces": {
            "*": 6
        }
    },

"pulseaudio": {
    // "scroll-step": 1, // %, можно раскомментировать для более плавной прокрутки
    "format": "{icon} {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}%  ",
    "format-source-muted": " ",
    "format-icons": {
        "headphone": " ",
        "hands-free": " ",
        "headset": " ",
        "phone": " ",
        "portable": " ",
        "car": " ",
        "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
},

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2
    },

    "memory": {
        "format": " {}%",
        "interval": 2
    },

    "disk#1": {
        "format": " {free}",
        "path": "/"
    },

    "disk#2": {
        "format": "🎮 {free}",
        "path": "/mnt/games" 
    },

    "clock": {
        "format": "{:%d.%m.%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "tray": {
        "spacing": 10
    }
}
