{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,

// ЖЕСТКИЕ ОТСТУПЫ ПАНЕЛИ ОТ КРАЕВ ЭКРАНА (В ПИКСЕЛЯХ)
    "margin-top": 5,
    "margin-left": 150,
    "margin-right": 150,
    
    "modules-left": ["hyprland/workspaces", "custom/playerctl"],
    "modules-center": ["clock", "wlr/taskbar"],
    "modules-right": ["disk#1", "disk#2","pulseaudio", "hyprland/language", "tray"],

    // --- ГРУППА ПЛЕЕРА ---
    "group/player": {
        "orientation": "horizontal",
        "modules": [
            "custom/player-prev",
            "custom/player-play",
            "custom/player-next",
            "custom/playerctl"
        ]
    },

"custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/cava.sh",
    "tooltip": false,
    "restart-interval": 1 // На случай, если скрипт упадет
},

  // --- Taskbar ---
"wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
               "Alacritty" 
            ],
    "rewrite": {
        "Firefox — Sharing Indicator": ""
    }
},
		// --- Плеер,показ.музыку ---
    "custom/playerctl": {
        "format": "{}", 
        "return-type": "json",
        "max-length": 35,
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then playerctl metadata --format '{\"text\": \"󰎈 {{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}'; else echo '{\"text\": \"\", \"class\": \"hidden\"}'; fi; sleep 1; done",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/player-prev": {
        "format": "󰒮 ",
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then echo \"󰒮\"; else echo \"\"; fi; sleep 1; done",
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/player-play": {
        "format": "{icon}",
        "return-type": "json",
        "format-icons": {
            "Playing": "󰏤 ",
            "Paused": "󰐊 "
        },
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then playerctl metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}'; else echo '{\"alt\": \"\", \"class\": \"hidden\"}'; fi; sleep 1; done",
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/player-next": {
        "format": "󰒭",
        "exec": "while true; do if playerctl status > /dev/null 2>&1; then echo \"󰒭\"; else echo \"\"; fi; sleep 1; done",
        "on-click": "playerctl next",
        "tooltip": false
    }, 

    // --- Столы раб. ---
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": " ",
            "2": " ",
            "3": "󰎆 ",
            "4": "󰓓 ",
            "5": "󰏆",
            "6": " ",
            "default": " "
        },
        "persistent-workspaces": {
            "*": 6
        }
    },

// --- Индткатор звука ---
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}%  ",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },

// --- Процессор ---
    "cpu": {
        "format": "󰍛  {usage}%",
        "interval": 2
    },
// --- Озу ---
    "memory": {
        "format": "  {}%",
        "interval": 2
    },
// --- Диск Основной ---
    "disk#1": {
        "format": " {free}",
        "path": "/"
    },
// --- Диск игровой ---
    "disk#2": {
        "format": "🎮 {free}",
        "path": "/mnt/games" 
    },
// --- Время ---
    "clock": {
        "format": "{:%d.%m.%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
// --- Раскладка клавы ---
    "hyprland/language": {
        "format": "󰌌  {}",
        "format-en": "EN",
        "format-ru": "RU"
    },
// --- Фоновые проги показывает ---
    "tray": {
        "spacing": 10
    }
}
